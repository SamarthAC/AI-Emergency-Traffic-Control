<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="bengaluru_structured.net.xml"/>
        <route-files value="bengaluru_structured.rou.xml"/>
        <additional-files value="bengaluru_structured.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="1800"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
        <ignore-route-errors value="false"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
